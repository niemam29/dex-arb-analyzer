{
  "name": "dex-arb-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analiza historycznych okazji arbitrażowych na DEX-ach AMM (praca inżynierska)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "export-results": "npm run export-results -w @dex-arb/api --",
    "data-dictionary": "npm run data-dictionary -w @dex-arb/db",
    "reproduce": "bash scripts/reproduce.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @dex-arb/db",
    "db:migrate": "npm run migrate -w @dex-arb/db",
    "db:migrate:test": "bash -c 'set -a; source .env; set +a; DATABASE_URL=\"$DATABASE_URL_TEST\" npm run db:migrate'",
    "db:seed": "npm run seed -w @dex-arb/ingest",
    "analyze": "npm run analyze -w @dex-arb/analysis --",
    "dev": "concurrently -n api,worker,web -c blue,green,magenta \"npm run dev -w @dex-arb/api\" \"npm run start -w @dex-arb/worker\" \"npm run dev -w @dex-arb/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
