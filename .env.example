# Połączenie z bazą deweloperską (Postgres 16 z docker-compose; port hosta 5433, nie 5432).
DATABASE_URL=postgres://dexarb:dexarb@localhost:5433/dexarb
# Baza testów integracyjnych — nazwa MUSI kończyć się na `_test` (createTestDb odmawia innej). Bez tej zmiennej testy DB są pomijane.
DATABASE_URL_TEST=postgres://dexarb:dexarb@localhost:5433/dexarb_test
# Archiwalny węzeł RPC Ethereum (wymagany przez worker/ingest/verify; eth_getLogs dla bloków z 2021–22).
RPC_URL=
# Publiczne RPC jako fallback po błędach (rotacja), rozdzielone przecinkami.
RPC_FALLBACK_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://eth.llamarpc.com
# Liczba równoległych zapytań RPC przy pobieraniu bloków/logów.
RPC_CONCURRENCY=4
# Rozmiar chunku bloków dla eth_getLogs (dzielony na pół, gdy RPC odrzuca odpowiedź jako zbyt dużą).
LOGS_CHUNK_BLOCKS=10000
# Liczba prób zadania w kolejce jobs przed oznaczeniem failed.
JOB_MAX_ATTEMPTS=3
# Odstęp odpytywania kolejki jobs przez workera [ms].
WORKER_POLL_MS=2000
# Włącza panel "Na żywo" (próbkowanie stanu pul z RPC w czasie rzeczywistym, bez zapisu do bazy); puste = wyłączony. Wymaga też RPC_URL.
LIVE_ENABLED=
# Odstęp między próbkami panelu "Na żywo" [ms].
LIVE_POLL_MS=15000
# Pojemność bufora historii próbek panelu "Na żywo" (240 próbek × 15 s ≈ 1 h przy domyślnym LIVE_POLL_MS).
LIVE_HISTORY=240
# Odstęp odświeżania parametrów modeli (scoring_models) używanych w panelu "Na żywo" [ms].
LIVE_MODELS_REFRESH_MS=300000
